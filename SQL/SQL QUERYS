-- Create and add tables 
-- case sensitive not required in sql

CREATE DATABASE TODO_APP;
USE TODO_APP;
CREATE TABLE tasks (
id INT NOT NULL auto_increment,
title VARCHAR(255) NOT NULL,
task_description varchar(255),
task VARCHAR(255) NOT NULL,
primary key(id)
)

-- Alter the table 

alter table tasks add isVisible boolean;


-- create another table and like the table using foreign key

create table finished_tasks (
id int not null auto_increment,
task_id int not null,
primary key(id),
foreign key(task_id) references tasks(id) 
);

